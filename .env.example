# ==============================================================================
# ICASE - Configuración de Variables de Entorno (.env.example)
# NOTA: No colocar claves de API reales ni contraseñas de producción aquí.
# ==============================================================================

# Base de Datos PostgreSQL (Docker Compose)
POSTGRES_USER=icase_user
POSTGRES_PASSWORD=icase_password
POSTGRES_DB=icase_db
DATABASE_URL=postgresql://icase_user:icase_password@localhost:5433/icase_db?schema=public

# Servidor Backend
PORT=8080
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:8080/api

# Proveedor de Inteligencia Artificial (mock | gemini | ollama | openai | n8n)
AI_PROVIDER=mock

# Configuración Gemini (Fase 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Configuración Ollama Local
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120000

# Configuración Documentos / PDF
MAX_PDF_SIZE_MB=10
MAX_AUDIO_SIZE_MB=100

# Configuración OpenAI (Fase 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Configuración n8n Workflow Automation (Fase 2)
# Si n8n corre en Docker: usar nombre del servicio o http://host.docker.internal:5678 si corre en el host
N8N_BASE_URL=http://localhost:5678
N8N_ANALYZE_WEBHOOK=
# Webhook de transcripción (acepta N8N_TRANSCRIBE_WEBHOOK o N8N_TRANSCRIPTION_WEBHOOK)
N8N_TRANSCRIBE_WEBHOOK=
N8N_TRANSCRIPTION_WEBHOOK=
N8N_MOCKUP_WEBHOOK=
N8N_TIMEOUT=120000
MOCKUP_MAX_REQUIREMENTS=12

# Estrategia de Análisis Inteligente de Requisitos (Fase 3)
# Opciones: ollama-first | ollama-only | gpt-only | deterministic-only
AI_ANALYSIS_STRATEGY=ollama-first
AI_FALLBACK_CONFIDENCE_THRESHOLD=0.65
AI_MAX_CHUNKS=12
AI_CHUNK_MAX_LENGTH=350
