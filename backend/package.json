{
  "name": "icase-backend",
  "version": "1.0.0",
  "description": "Backend API for ICASE (Integrated Computer-Aided Software Engineering) Tool",
  "main": "src/server.js",
  "scripts": {
    "test": "node --require ./tests/fixtures/offline.cjs --test tests/*.test.js",
    "test:extraction": "node --require ./tests/fixtures/offline.cjs --test tests/document_extraction.test.js tests/requirement_flow.test.js",
    "test:requirements:integration": "node --test tests/analysis_postgres.integration.js",
    "test:integration": "node --test tests/analysis_postgres.integration.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test:integrity": "node --require ./tests/fixtures/offline.cjs --test tests/catalog_integrity.test.js",
    "test:postgres": "node --test tests/analysis_postgres.integration.js"
  },
  "keywords": [
    "icase",
    "software-engineering",
    "prisma",
    "express",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  }
}
