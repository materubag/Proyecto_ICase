# ==============================================================================
# ICASE - Configuración de Variables de Entorno (.env.example)
# NOTA: No colocar claves de API reales ni contraseñas de producción aquí.
# ==============================================================================

# Base de Datos PostgreSQL (Docker Compose)
POSTGRES_USER=icase_user
POSTGRES_PASSWORD=icase_password
POSTGRES_DB=icase_db
DATABASE_URL=postgresql://icase_user:icase_password@localhost:5433/icase_db?schema=public

# Servidor Backend
PORT=8080
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:8080/api

# Proveedor de Inteligencia Artificial (gemini | ollama | openai | mock)
AI_PROVIDER=gemini

# Configuración Google Gemini (gemini-3.1-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_INPUT_CHARS=16000
GEMINI_MAX_OUTPUT_TOKENS=384
GEMINI_MAX_ITEMS_PER_BATCH=20
GEMINI_MIN_REQUEST_INTERVAL_MS=6000
GEMINI_THINKING_LEVEL=minimal
GEMINI_TEMPERATURE=0
GEMINI_TOKEN_PREFLIGHT=false

# Configuración Ollama Local (Alternativo)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120000

# Configuración Faster-Whisper Local (Microservicio Audio)
WHISPER_BASE_URL=http://whisper:8001
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=es
WHISPER_VAD_FILTER=true

# Configuración Documentos / PDF y Audio
MAX_PDF_SIZE_MB=10
MAX_AUDIO_SIZE_MB=100
SIMILARITY_THRESHOLD=0.85

# Configuración OpenAI (Opcional - Nunca requerido para el flujo principal)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Configuración n8n Workflow Automation (EXCLUSIVO PARA MOCKUPS)
N8N_BASE_URL=http://localhost:5678
N8N_MOCKUP_WEBHOOK=
N8N_TIMEOUT=120000
MOCKUP_MAX_REQUIREMENTS=12

# Estrategia de Análisis de Requisitos
AI_ANALYSIS_STRATEGY=rules-first
AI_FALLBACK_CONFIDENCE_THRESHOLD=0.65
AI_MAX_CHUNKS=20
AI_CHUNK_MAX_LENGTH=350
